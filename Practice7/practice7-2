library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity practice7 is
    Port (
        clk       : in  STD_LOGIC;
        rst       : in  STD_LOGIC;
        pixel_x   : in  STD_LOGIC_VECTOR(9 downto 0);
        pixel_y   : in  STD_LOGIC_VECTOR(9 downto 0);
        video_on  : in  STD_LOGIC;
        rgb       : out STD_LOGIC_VECTOR(11 downto 0)
    );
end practice7;

architecture Behavioral of practice7 is

    signal x : integer;
    signal y : integer;

    -- 方塊位置
    signal box_x : integer := 270;
    signal box_y : integer := 190;

begin

    x <= to_integer(unsigned(pixel_x));
    y <= to_integer(unsigned(pixel_y));

	
div: process(i_clk, i_rst)
	begin
	if (i_rst = '0') then 
            divCnt <= (others => '0');
        elsif rising_edge(i_clk) then 
            divCnt <= divCnt + 1;
        end if;
    end process;

    slowClk <= divCnt(23);

    ------------------------------------------------
    -- 方塊位置
    ------------------------------------------------
    process(clk, rst)
    begin
        if rst = '1' then
            box_x <= 270;

        elsif rising_edge(clk) then

            -- 每個 clock 往右移
            box_x <= box_x + 1;

            -- 超出畫面回到左邊
            if box_x > 640 then
                box_x <= 0;
            end if;

        end if;
    end process;

    ------------------------------------------------
    -- VGA 
    ------------------------------------------------
    process(video_on, x, y, box_x, box_y)
    begin

        if video_on = '0' then
            rgb <= "000000000000";

        else

            -- 根據 box_x 畫方塊
            if (x >= box_x and x <= box_x + 100) and
               (y >= box_y and y <= box_y + 100) then

                rgb <= "111111110000";

            else
                rgb <= "000000000000";

            end if;
        end if;

    end process;

end Behavioral;
