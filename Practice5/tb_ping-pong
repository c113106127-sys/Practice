library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity tb_practice5 is
    -- Testbench 沒有外部接口
end tb_practice5;

architecture behavior of tb_practice5 is 

    -- 1. 宣告元件 (Component Declaration)
    component practice5
    PORT(
         i_clk   : IN  std_logic;
         i_rst_n : IN  std_logic;
         i_btn   : IN  std_logic_vector(1 downto 0);
         o_led   : OUT std_logic_vector(7 downto 0)
        );
    end component;
    
    -- 2. 宣告訊號 (Signals)
    signal i_clk   : std_logic := '0';
    signal i_rst_n : std_logic := '0';
    signal i_btn   : std_logic_vector(1 downto 0) := "00";
    signal o_led   : std_logic_vector(7 downto 0);

    -- 定義時脈週期 (50MHz = 20ns)
    constant clk_period : time := 20 ns;
 
begin
 
    -- 3. 實例化 (Instantiate the UUT)
    uut: practice5 PORT MAP (
          i_clk   => i_clk,
          i_rst_n => i_rst_n,
          i_btn   => i_btn,
          o_led   => o_led
        );

    -- 4. 時脈產生程序
    clk_process :process
    begin
        i_clk <= '0';
        wait for clk_period/2;
        i_clk <= '1';
        wait for clk_period/2;
    end process;
 
    -- 5. 測試激勵程序
    stim_proc: process
    begin		
        ------------------------------------------------------------
        -- 階段 A: 系統重置
        ------------------------------------------------------------
        report "Phase A: System Reset";
        i_rst_n <= '0';
        wait for 100 ns;	
        i_rst_n <= '1';
        wait for clk_period*5;
        
        -- 檢查初始 LED (應該是 S1 計分模式，分數 0:0，LED 全滅或顯示 00000000)
        assert o_led = "00000000" report "Error: Initial LED should be 00000000" severity note;

        ------------------------------------------------------------
        -- 階段 B: P1 犯規測試 (Early Press)
        ------------------------------------------------------------
        report "Phase B: Testing P1 Early Foul";
        
        -- 1. 開始遊戲
        i_btn <= "01"; -- P1 按下開始
        wait for clk_period * 2;
        i_btn <= "00";
        
        -- 2. 等待球移動出來 (例如移動到 LED 1)
        wait until o_led(1) = '1'; 
        
        -- 3. P1 在球還沒回來時亂按 (犯規)
        wait for clk_period;
        i_btn <= "01"; 
        wait for clk_period * 2;
        i_btn <= "00";
        
        -- 4. 檢查是否進入計分模式 (S1)，且 P2 得分
        -- P2 (左邊) 得 1 分 -> LED[7:4] = 0001 -> o_led = 00010000
        wait for clk_period * 2;
        if o_led(7 downto 4) = "0001" then
            report "Pass: P1 Foul detected, P2 Score = 1";
        else
            report "Fail: Score did not update correctly for P1 Foul" severity error;
        end if;

        ------------------------------------------------------------
        -- 階段 C: P2 漏接測試 (Late Miss)
        ------------------------------------------------------------
        report "Phase C: Testing P2 Late Miss";
        
        -- 1. 重新開始下一局
        wait for 100 ns;
        i_btn <= "01"; -- 按下開始
        wait for clk_period * 2;
        i_btn <= "00";
        
        -- 2. 等待球移動到最左邊 (LED 7)
        wait until o_led(7) = '1';
        report "Ball reached Left Edge (LED 7)";
        
        -- 3. 故意不按按鈕，讓它超時 (漏接)
        -- 等待足夠長的時間讓計數器再次觸發 move_tick
        wait for clk_period * 20; 
        
        -- 4. 檢查是否進入計分模式，且 P1 得分
        -- 目前分數狀態：P2=1 (來自上一局), P1=1 (這局得分) -> LED = 00010001
        wait for clk_period * 2;
        if o_led(3 downto 0) = "0001" then
             report "Pass: P2 Missed, P1 Score = 1";
        else
             report "Fail: Score did not update correctly for P2 Miss" severity error;
        end if;

        ------------------------------------------------------------
        -- 階段 D: 正常來回測試 (Rally)
        ------------------------------------------------------------
        report "Phase D: Testing Normal Rally";
        
        -- 1. 重新開始
        wait for 100 ns;
        i_btn <= "01"; 
        wait for clk_period * 2;
        i_btn <= "00";
        
        -- 2. 球從右(0)發到左(7)
        wait until o_led(7) = '1';
        
        -- 3. P2 成功回擊
        wait for clk_period; -- 等穩一點
        i_btn <= "10"; -- P2 (左按鈕) 按下
        wait for clk_period * 2;
        i_btn <= "00";
        
        -- 4. 檢查球是否往右彈 (LED 6 亮起)
        wait until o_led(6) = '1';
        report "Pass: P2 Returned the ball successfully!";

        report "Simulation Completed";
        wait;
    end process;

end behavior;
