LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.numeric_std.ALL;

ENTITY tb_practice5 IS
END tb_practice5;

ARCHITECTURE behavior OF tb_practice5 IS 

    -- 1. 宣告待測元件 (UUT)
    COMPONENT practice5
    PORT(
         i_clk : IN  std_logic;
         i_rst : IN  std_logic;
         i_btn1 : IN  std_logic;
         i_btn2 : IN  std_logic;
         o_led : OUT  std_logic_vector(7 downto 0)
        );
    END COMPONENT;
    
    -- 2. 訊號宣告
    signal i_clk : std_logic := '0';
    signal i_rst : std_logic := '0';
    signal i_btn1 : std_logic := '0';
    signal i_btn2 : std_logic := '0';
    signal o_led : std_logic_vector(7 downto 0);

    -- 時脈定義 (100MHz)
    constant i_clk_period : time := 10 ns;
 
BEGIN
 
    -- 3. 實例化元件
    uut: practice5 PORT MAP (
          i_clk => i_clk,
          i_rst => i_rst,
          i_btn1 => i_btn1,
          i_btn2 => i_btn2,
          o_led => o_led
        );

    -- 4. 時脈產生
    i_clk_process :process
    begin
        i_clk <= '0';
        wait for i_clk_period/2;
        i_clk <= '1';
        wait for i_clk_period/2;
    end process;
 

    -- 5. 測試劇本 (Stimulus)
    stim_proc: process
    begin		
        -- =========================================================
        -- 階段 0: 系統重置
        -- =========================================================
        report "=== Simulation Start ===";
        i_rst <= '0'; 
        i_btn1 <= '0';
        i_btn2 <= '0';
        wait for 100 ns;	
        i_rst <= '1'; 
        wait for 100 ns;

        -- =========================================================
        -- 階段 1: 測試「成功擊回」 (Normal Rally)
        -- 流程: P1發球 -> P2回擊 -> P1回擊
        -- =========================================================
        report "--- Test 1: Successful Rally ---";
        
        -- 1.1 P1 發球
        i_btn1 <= '1'; 
        wait for 20 ns; 
        i_btn1 <= '0';
        
        -- 1.2 等待球移動到最左邊 (P2 防守區)
        -- LED 顯示 10000000 時，代表球在 ballPos(8)，下一個就是 ballPos(9)
        wait until o_led = "10000000";
        report "Ball at Left Edge (LED 7)";
        
        -- 模擬反應延遲 (球進入虛擬牆壁 bit 9)
        wait for 5 ns; 
        
        -- 1.3 P2 正確回擊
        i_btn2 <= '1';
        wait for 20 ns;
        i_btn2 <= '0';
        report "P2 Hit the ball!";

        -- 1.4 等待球移動到最右邊 (P1 防守區)
        wait until o_led = "00000001";
        report "Ball at Right Edge (LED 0)";
        
        wait for 5 ns;

        -- 1.5 P1 正確回擊
        i_btn1 <= '1';
        wait for 20 ns;
        i_btn1 <= '0';
        report "P1 Hit the ball!";
        
        -- 確認球是否反彈 (LED 應該變為 00000010)
        wait until o_led = "00000010";
        report "Ball bounced back successfully.";


        -- =========================================================
        -- 階段 2: 測試「提前打」 (Early Hit / Foul)
        -- 流程: 球往左飛 -> P2 在球還沒到時按下 -> P2 輸，P1 得分
        -- =========================================================
        report "--- Test 2: Early Hit (Foul) ---";
        
        -- 目前球正在往左飛 (因為 P1 剛打回去)
        -- 等待球到中間 (例如 LED 4: 00010000)
        wait until o_led = "00010000";
        report "Ball is in the middle...";
        
        -- P2 太早按了!
        i_btn2 <= '1';
        wait for 20 ns;
        i_btn2 <= '0';
        report "P2 pressed TOO EARLY!";
        
        -- 預期結果: 狀態機偵測到犯規，切回 s0，P1 得分
        -- 等待幾個 clock 讓分數更新
        wait for 100 ns;
        
        -- 檢查分數 (P1 應該得 1 分)
        -- LED(3 downto 0) 是 P1 分數
        if o_led(3 downto 0) = "0001" then
             report "PASS: P1 Scored (due to P2 early hit)";
        else
             report "FAIL: Score did not update correctly for Early Hit.";
        end if;


        -- =========================================================
        -- 階段 3: 測試「漏接」 (Miss)
        -- 流程: P2 發球 -> 球往右飛 -> P1 不按 -> P1 輸，P2 得分
        -- =========================================================
        report "--- Test 3: Miss (Leak) ---";
        
        -- 因為剛剛犯規回到 s0，現在重新發球
        -- 這次換 P2 發球
        i_btn2 <= '1';
        wait for 20 ns;
        i_btn2 <= '0';
        report "P2 Serves";
        
        -- 等待球到最右邊 (LED 0)
        wait until o_led = "00000001";
        report "Ball at Right Edge...";
        
        -- *關鍵*: 這裡故意不按 i_btn1
        -- 等待球消失 (變成 00000000)
        wait until o_led = "00000000";
        report "Ball went out of bounds (P1 Missed)";
        
        -- 等待分數更新
        wait for 100 ns;
        
        -- 檢查分數 (P2 應該得 1 分)
        -- LED(7 downto 4) 是 P2 分數
        if o_led(7 downto 4) = "0001" then
             report "PASS: P2 Scored (due to P1 miss)";
        else
             report "FAIL: Score did not update correctly for Miss.";
        end if;

        report "=== Simulation Finished ===";
        wait;
    end process;

END;
