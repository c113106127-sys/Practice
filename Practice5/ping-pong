library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity practice5 is
    Port ( 
        i_clk      : in  STD_LOGIC; 
        i_rst_n    : in  STD_LOGIC; 
        i_btn      : in  STD_LOGIC_VECTOR(1 downto 0);
        o_led      : out STD_LOGIC_VECTOR(7 downto 0)
    );
end practice5;

architecture Behavioral of practice5 is

    -- [1] 狀態定義
    type state_type is (S0_MOVE_TO_LEFT, S1_MOVE_TO_RIGHT, S2_SCORE);
    signal current_state : state_type;

    -- [2] 遊戲訊號
    signal ball_pos : STD_LOGIC_VECTOR(7 downto 0); 
    signal score_p1 : STD_LOGIC_VECTOR(3 downto 0); 
    signal score_p2 : STD_LOGIC_VECTOR(3 downto 0); 
    signal led_score_view : STD_LOGIC_VECTOR(7 downto 0);

    -- [3] 除頻與按鍵
    constant DIV_MAX_VAL : integer := 5; -- 模擬用 (燒錄請改大)
    signal div_cnt     : STD_LOGIC_VECTOR(23 downto 0);
    signal move_tick   : std_logic; 
    signal btn_pressed : std_logic_vector(1 downto 0); 
    signal btn_last    : std_logic_vector(1 downto 0);

    -- [4] 各 Process 之間的溝通訊號 (建議值)
    -- S0 建議值
    signal s0_next_state : state_type;
    signal s0_next_ball  : STD_LOGIC_VECTOR(7 downto 0);
    signal s0_score_inc  : std_logic;
    -- S1 建議值
    signal s1_next_state : state_type;
    signal s1_next_ball  : STD_LOGIC_VECTOR(7 downto 0);
    signal s1_score_inc  : std_logic;
    -- S2 建議值
    signal s2_next_state : state_type;
    signal s2_next_ball  : STD_LOGIC_VECTOR(7 downto 0);

begin

    ----------------------------------------------------------
    -- 1. 基礎設施 Process (除頻器 & 按鍵)
    ----------------------------------------------------------
    
    -- 除頻器
    process(i_clk, i_rst_n)
    begin
        if i_rst_n = '0' then
            div_cnt <= (others => '0');
            move_tick <= '0';
        elsif rising_edge(i_clk) then
            if div_cnt = DIV_MAX_VAL then
                div_cnt <= (others => '0');
                move_tick <= '1';
            else
                div_cnt <= div_cnt + 1;
                move_tick <= '0';
            end if;
        end if;
    end process;

    -- 按鍵邊緣偵測
    process(i_clk, i_rst_n)
    begin
        if i_rst_n = '0' then
            btn_last <= "00";
            btn_pressed <= "00";
        elsif rising_edge(i_clk) then
            btn_pressed <= i_btn and (not btn_last);
            btn_last <= i_btn;
        end if;
    end process;

    ----------------------------------------------------------
    -- 2. 狀態邏輯 Process (S0, S1, S2 分開計算)
    ----------------------------------------------------------

    -- [Process S0] 球往左跑 (0->7)
    proc_s0_logic : process(ball_pos, btn_pressed, move_tick)
    begin
        s0_next_state <= S0_MOVE_TO_LEFT; -- 預設
        s0_next_ball  <= ball_pos;
        s0_score_inc  <= '0';

        if btn_pressed(1) = '1' then
            if ball_pos(7) = '1' then
                s0_next_state <= S1_MOVE_TO_RIGHT;
            else
                s0_next_state <= S2_SCORE;
                s0_score_inc  <= '1';
            end if;
        elsif move_tick = '1' then
            if ball_pos(7) = '0' then
                s0_next_ball <= ball_pos(6 downto 0) & '0';
            else
                s0_next_state <= S2_SCORE;
                s0_score_inc  <= '1';
            end if;
        end if;
    end process;

    -- [Process S1] 球往右跑 (7->0)
    proc_s1_logic : process(ball_pos, btn_pressed, move_tick)
    begin
        s1_next_state <= S1_MOVE_TO_RIGHT; -- 預設
        s1_next_ball  <= ball_pos;
        s1_score_inc  <= '0';

        if btn_pressed(0) = '1' then
            if ball_pos(0) = '1' then
                s1_next_state <= S0_MOVE_TO_LEFT;
            else
                s1_next_state <= S2_SCORE;
                s1_score_inc  <= '1';
            end if;
        elsif move_tick = '1' then
            if ball_pos(0) = '0' then
                s1_next_ball <= '0' & ball_pos(7 downto 1);
            else
                s1_next_state <= S2_SCORE;
                s1_score_inc  <= '1';
            end if;
        end if;
    end process;

    -- [Process S2] 計分等待
    proc_s2_logic : process(ball_pos, btn_pressed)
    begin
        s2_next_state <= S2_SCORE; -- 預設
        s2_next_ball  <= ball_pos;

        if btn_pressed(0) = '1' then
            s2_next_state <= S0_MOVE_TO_LEFT;
            s2_next_ball  <= "00000001";
        elsif btn_pressed(1) = '1' then
            s2_next_state <= S1_MOVE_TO_RIGHT;
            s2_next_ball  <= "10000000";
        end if;
    end process;

    ----------------------------------------------------------
    -- 3. 主控 Process (集中更新 State & Register)
    ----------------------------------------------------------
    main_update_process : process(i_clk, i_rst_n)
    begin
        if i_rst_n = '0' then
            current_state <= S2_SCORE;
            ball_pos      <= "00000001";
            score_p1      <= (others => '0');
            score_p2      <= (others => '0');
        elsif rising_edge(i_clk) then
            case current_state is
                when S0_MOVE_TO_LEFT =>
                    current_state <= s0_next_state;
                    ball_pos      <= s0_next_ball;
                    if s0_score_inc = '1' then score_p1 <= score_p1 + 1; end if;

                when S1_MOVE_TO_RIGHT =>
                    current_state <= s1_next_state;
                    ball_pos      <= s1_next_ball;
                    if s1_score_inc = '1' then score_p2 <= score_p2 + 1; end if;

                when S2_SCORE =>
                    current_state <= s2_next_state;
                    ball_pos      <= s2_next_ball; 

                when others =>
                    current_state <= S2_SCORE;
            end case;
        end if;
    end process;

    ----------------------------------------------------------
    -- 4. 硬體輸出連接 (LED Output Driver)
    -- 這裡負責將內部訊號 (ball_pos, score) 轉譯給外部腳位 (o_led)
    ----------------------------------------------------------
    
    -- 組合分數訊號
    led_score_view(7 downto 4) <= score_p2;
    led_score_view(3 downto 0) <= score_p1;

    -- LED 多工器：根據狀態決定顯示球還是顯示分數
    with current_state select
        o_led <= ball_pos       when S0_MOVE_TO_LEFT,
                 ball_pos       when S1_MOVE_TO_RIGHT,
                 led_score_view when S2_SCORE,
                 (others => '0') when others;

end Behavioral;
