library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;
use IEEE.NUMERIC_STD.ALL;

entity practice5 is
    Port ( 
        i_clk        : in  STD_LOGIC; 
        i_rst_n      : in  STD_LOGIC; 
        i_btn        : in  STD_LOGIC_VECTOR(1 downto 0); 
        o_led        : out STD_LOGIC_VECTOR(7 downto 0)
    );
end practice5;

architecture Behavioral of practice5 is

    type STATE_TYPE is (S0_MOVE_TO_LEFT, S1_MOVE_TO_RIGHT, S2_SCORE);
    signal s_currentState : STATE_TYPE;

    -- 資料訊號
    signal s_ballPos    : STD_LOGIC_VECTOR(7 downto 0); 
    signal s_scoreP1    : STD_LOGIC_VECTOR(3 downto 0); 
    signal s_scoreP2    : STD_LOGIC_VECTOR(3 downto 0); 
    
    -- 時序訊號
    signal s_divCnt     : STD_LOGIC_VECTOR(24 downto 0); 
    signal s_slowClkBit : STD_LOGIC; 

    -- 分數控制旗標
    signal s_ctrlIncP1     : STD_LOGIC;
    signal s_ctrlIncP2     : STD_LOGIC;
    signal s_ctrlClrGame   : STD_LOGIC;

    signal s_prev_btn      : STD_LOGIC_VECTOR(1 downto 0);

begin

    ------------------------------------------------------------------
    -- 1. 除頻計數器 
    ------------------------------------------------------------------
    p_divCnt : process (i_clk, i_rst_n) 
    begin 
        if (i_rst_n = '0') then 
            s_divCnt <= (others => '0');
        elsif rising_edge(i_clk) then 
            s_divCnt <= s_divCnt + 1;
        end if;
    end process;

    -- [重要設定] 燒錄時請確認 Bit 位數
    -- 模擬用 Bit 2，燒錄用 Bit 22 或 24
    s_slowClkBit <= s_divCnt(22); 

    ---------------------------------------------------------------------------
    -- 2. FSM 狀態機 
    ---------------------------------------------------------------------------
    p_fsm_state : process (s_slowClkBit, i_rst_n) 
    begin
        if i_rst_n = '0' then
            s_currentState <= S2_SCORE;
            s_ctrlIncP1    <= '0';
            s_ctrlIncP2    <= '0';
            s_ctrlClrGame  <= '0';
            s_prev_btn     <= "00"; -- 重置舊按鈕紀錄
        elsif rising_edge(s_slowClkBit) then 

            s_prev_btn <= i_btn;

            s_ctrlIncP1    <= '0';
            s_ctrlIncP2    <= '0';
            s_ctrlClrGame  <= '0';

            case s_currentState is            
                when S0_MOVE_TO_LEFT =>
                    -- P2 按下按鈕
                    if (i_btn(1) = '1') then 
                        if (s_ballPos(7) = '1') then 
                            s_currentState <= S1_MOVE_TO_RIGHT; -- 成功回擊
                        else 
                            s_currentState <= S2_SCORE; -- 太早按，輸球
                            if (s_scoreP1 = "1110") then s_ctrlClrGame <= '1'; 
                            else s_ctrlIncP1 <= '1'; end if;
                        end if;
                    
                    -- 球撞牆 
                    elsif (s_ballPos(7) = '1') then 
                        s_currentState <= S2_SCORE; 
                        if (s_scoreP1 = "1110") then s_ctrlClrGame <= '1'; 
                        else s_ctrlIncP1 <= '1'; end if;
                    end if;

                when S1_MOVE_TO_RIGHT =>
                    -- P1 按下按鈕
                    if (i_btn(0) = '1') then 
                        if (s_ballPos(0) = '1') then 
                            s_currentState <= S0_MOVE_TO_LEFT; -- 成功回擊
                        else 
                            s_currentState <= S2_SCORE; -- 太早按，輸球
                            if (s_scoreP2 = "1110") then s_ctrlClrGame <= '1';
                            else s_ctrlIncP2 <= '1'; end if;
                        end if;
                    
                    -- 球撞牆
                    elsif (s_ballPos(0) = '1') then 
                        s_currentState <= S2_SCORE; 
                        if (s_scoreP2 = "1110") then s_ctrlClrGame <= '1';
                        else s_ctrlIncP2 <= '1'; end if;
                    end if;

                when S2_SCORE =>
                    if (i_btn(0) = '1' and s_prev_btn(0) = '0') then 
                        s_currentState <= S0_MOVE_TO_LEFT; 
                    elsif (i_btn(1) = '1' and s_prev_btn(1) = '0') then 
                        s_currentState <= S1_MOVE_TO_RIGHT; 
                    end if;

                when others => s_currentState <= S2_SCORE;
            end case;
        end if;
    end process;

    ---------------------------------------------------------------------------
    -- 3. 球的位置控制 
    ---------------------------------------------------------------------------
    p_ball : process (s_slowClkBit, i_rst_n)
    begin
        if (i_rst_n = '0') then 
            s_ballPos <= "00000001";
        elsif rising_edge(s_slowClkBit) then 
            
            case s_currentState is
                when S2_SCORE =>
                    if (i_btn(0) = '1' and s_prev_btn(0) = '0') then s_ballPos <= "00000001";
                    elsif (i_btn(1) = '1' and s_prev_btn(1) = '0') then s_ballPos <= "10000000";
                    end if;

                when S0_MOVE_TO_LEFT =>
                    if (s_ballPos(7) = '1' and i_btn(1) = '1') then
                        s_ballPos <= s_ballPos; 
                    else
                        s_ballPos(7 downto 1) <= s_ballPos(6 downto 0);
                        s_ballPos(0) <= '0';
                    end if;

                when S1_MOVE_TO_RIGHT =>
                    if (s_ballPos(0) = '1' and i_btn(0) = '1') then
                        s_ballPos <= s_ballPos;
                    else
                        s_ballPos(6 downto 0) <= s_ballPos(7 downto 1);
                        s_ballPos(7) <= '0';
                    end if;

                when others =>
                    s_ballPos <= "00000001";
            end case;
        end if;
    end process;

    ---------------------------------------------------------------------------
    -- 4. P1 分數計數器 
    ---------------------------------------------------------------------------
    p_scoreP1 : process (s_slowClkBit, i_rst_n)
    begin
        if (i_rst_n = '0') then 
            s_scoreP1 <= (others => '0');
        elsif rising_edge(s_slowClkBit) then
            if (s_ctrlClrGame = '1') then 
                s_scoreP1 <= (others => '0');
            elsif (s_ctrlIncP1 = '1') then 
                s_scoreP1 <= s_scoreP1 + 1;
            end if;
        end if;
    end process;

    ---------------------------------------------------------------------------
    -- 5. P2 分數計數器
    ---------------------------------------------------------------------------
    p_scoreP2 : process (s_slowClkBit, i_rst_n)
    begin
        if (i_rst_n = '0') then 
            s_scoreP2 <= (others => '0');
        elsif rising_edge(s_slowClkBit) then
            if (s_ctrlClrGame = '1') then 
                s_scoreP2 <= (others => '0');
            elsif (s_ctrlIncP2 = '1') then 
                s_scoreP2 <= s_scoreP2 + 1;
            end if;
        end if;
    end process;

    ---------------------------------------------------------------------------
    -- 6. LED 輸出
    ---------------------------------------------------------------------------
    p_led : process (s_slowClkBit, i_rst_n)
    begin
        if (i_rst_n = '0') then
            o_led <= (others => '0');
        elsif rising_edge(s_slowClkBit) then
            case s_currentState is
                when S2_SCORE => 
                    o_led(7 downto 4) <= s_scoreP2;
                    o_led(3 downto 0) <= s_scoreP1;
                when others => 
                    o_led <= s_ballPos;
            end case;
        end if;
    end process;

end Behavioral;
