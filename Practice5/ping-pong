library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;
use IEEE.NUMERIC_STD.ALL;

entity practice5 is port(

	i_clk: in std_logic;
	i_rst: in std_logic;
	i_btn1: in std_logic;
	i_btn2: in std_logic;
	o_led:	out std_logic_vector(7 downto 0)
	);
end practice5 ;

architecture Behavioral of practice5 is
	type state_type is (s0, s1, s2);
	signal cstate: state_type;
    
	signal ballPos : std_logic_vector(9 downto 0);
	signal slowClk : std_logic;
	signal divCnt : std_logic_vector(35 downto 0);
	
	signal p1_score : std_logic_vector(3 downto 0);
	signal p2_score : std_logic_vector(3 downto 0);
	
	signal p1_core : std_logic;
	signal p2_core : std_logic;
	signal score : std_logic;


begin	
	
div: process(i_clk, i_rst)
	begin
	if (i_rst = '0') then 
            divCnt <= (others => '0');
        elsif rising_edge(i_clk) then 
            divCnt <= divCnt + 1;
        end if;
    end process;

    slowClk <= divCnt(2);
fsm: process(i_clk, i_rst)
	 begin
		if  i_rst = '0' then
			cstate <= s0;
		elsif rising_edge(i_clk) then
		  p1_core<= '0';
		   p2_core<= '0';
			case cstate is
				when s0 =>
					if i_btn1 = '1' and ballPos = "0000000010" then
						cstate <= s1;
						score <= '0';
					elsif i_btn2 = '1' and ballPos = "0100000000" then
						cstate <= s2;
						score <= '0';
					elsif p1_score = "1110" then
						score <= '1';
					elsif p2_score = "1110" then
						score <= '1';
					end if;
					
				when s1 =>--左移
					if ballPos = "0100000000" and i_btn2 = '1' then
					cstate <= s2;
					elsif ballPos = "1000000000"  then
					cstate <= s0;--失敗得分
					p1_core <= '1';	
							
                    
					elsif ballPos /= "0100000000" and i_btn2 = '1' then
					cstate <= s0;
					p1_core <= '1';

					else
					cstate <= s1;
					end if;
				when s2 =>--右移
					if ballPos = "0000000010" and i_btn1 = '1' then
					cstate <= s1;
					elsif ballPos = "0000000001"  then
					cstate <= s0;
					p2_core <= '1';

					elsif ballPos /= "0000000010" and i_btn1 = '1' then
					cstate <= s0;
					p2_core <= '1';

					else
					cstate <= s2;
					end if;
				when others=>
					cstate <= cstate;
			end case;
		end if;
	end process;
	
bballPos: process(slowClk, i_rst)
	begin
		if i_rst = '0' then
			ballPos <="0100000000";
		elsif rising_edge(slowClk) then
			case cstate is
				when s0 =>
					if i_btn1 = '1' then 
						ballPos <= "0000000010";
					elsif i_btn2 = '1' then
						ballPos <= "0100000000";
					end if;
				when s1 =>--左移
					ballPos <= ballPos(8 downto 0) & '0';
				when s2 =>--又移
				  ballPos <= '0' & ballPos(9 downto 1);
				when others=>
					null;
			end case;
		end if;
	end process;
		
pp1_score: process(i_clk, i_rst)
	begin
		if i_rst = '0' then
			p1_score <= (others => '0');
		elsif rising_edge(i_clk) then
			if p1_core = '1' then
				p1_score <= p1_score + 1;
			elsif score = '1' then
				p1_score <= "0000";
			    
			end if;
		end if;
	end process;
	
pp2_score: process(i_clk, i_rst)
	begin
		if i_rst = '0' then
			p2_score <= (others => '0');
		elsif rising_edge(i_clk) then
			if p2_core = '1' then
				p2_score <= p2_score + 1;
			elsif score = '1' then
				p2_score <= "0000";
			end if;
		end if;
	end process;
		
led: process(i_clk, i_rst)
	begin
		if i_rst = '0' then
			o_led <= (others => '0');
		elsif rising_edge(i_clk) then	
			case cstate is
				when s0 =>
					o_led(7 downto 4) <= p2_score;
					o_led(3 downto 0) <= p1_score;
                when others => 
                    o_led <= ballPos(8 downto 1);
            end case;
        end if;
    end process;
end Behavioral;
