##########################################################
# Clock (100 MHz)
##########################################################
set_property PACKAGE_PIN Y9 [get_ports i_clk]
set_property IOSTANDARD LVCMOS33 [get_ports i_clk]
create_clock -period 10.000 -name sys_clk [get_ports i_clk]

##########################################################
# Reset (i_rstp)
##########################################################
set_property PACKAGE_PIN G22 [get_ports i_rst]
set_property IOSTANDARD LVCMOS33 [get_ports i_rst]

##########################################################
# o_count1 -> LED0 ~ LED3
##########################################################
set_property PACKAGE_PIN T22 [get_ports {o_count1[0]}]
set_property PACKAGE_PIN T21 [get_ports {o_count1[1]}]
set_property PACKAGE_PIN U22 [get_ports {o_count1[2]}]
set_property PACKAGE_PIN U21 [get_ports {o_count1[3]}]

set_property IOSTANDARD LVCMOS33 [get_ports {o_count1[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_count1[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_count1[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_count1[3]}]

##########################################################
# o_count2 -> LED4 ~ LED7
##########################################################
set_property PACKAGE_PIN V22 [get_ports {o_count2[0]}]
set_property PACKAGE_PIN W22 [get_ports {o_count2[1]}]
set_property PACKAGE_PIN U19 [get_ports {o_count2[2]}]
set_property PACKAGE_PIN U14 [get_ports {o_count2[3]}]

set_property IOSTANDARD LVCMOS33 [get_ports {o_count2[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_count2[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_count2[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {o_count2[3]}]
